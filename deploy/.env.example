# Auf dem Server als deploy/.env ablegen (chmod 600).
# Achtung: $ in Werten als $$ escapen (Compose-Interpolation).

# Gemeinsames Passwort für den Login (bekommt der Kunde)
HUPSI_PASSWORD=bitte-aendern

# Private API Key des HUPSI-Klaviyo-Accounts.
# Benötigter Scope: Subscriptions → Write (oder Full Access).
KLAVIYO_API_KEY=pk_xxx

# Optional: eigener Session-Secret (sonst aus Passwort abgeleitet)
SESSION_SECRET=
